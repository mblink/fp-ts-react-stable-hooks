{
  "name": "fp-ts-react-stable-hooks",
  "version": "1.5.0",
  "description": "Stable hooks for react using FP-TS equality checks instead of shallow (reference) object comparison",
  "main": "dist/lib/index.js",
  "module": "dist/es2015/index.js",
  "types": "dist/es2015/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.commonjs.json",
    "clean": "rimraf ./dist",
    "lint:no-fix": "eslint 'src/**/*.{ts,tsx}' 'test/**/*.{ts,tsx}'",
    "lint": "npm run lint:no-fix -- --fix",
    "prepublishOnly": "npm run clean && npm run build && npm run test -- --ci --silent && npm run lint:no-fix -- --max-warnings 0",
    "test": "jest",
    "test:watch": "jest --watch",
    "typecheck": "tsc -p test/tsconfig.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mblink/fp-ts-react-stable-hooks.git"
  },
  "keywords": [
    "fp-ts",
    "react",
    "useState",
    "useEffect",
    "useStable",
    "stable",
    "equality",
    "deep",
    "object",
    "comparison"
  ],
  "author": "jleider",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/mblink/fp-ts-react-stable-hooks/issues"
  },
  "homepage": "https://github.com/mblink/fp-ts-react-stable-hooks#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^6.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fp-ts": "^2.16.11",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rimraf": "^6.1.4",
    "ts-jest": "^29.4.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0"
  },
  "peerDependencies": {
    "fp-ts": ">=2.8.0",
    "react": ">=16.8.0"
  }
}
